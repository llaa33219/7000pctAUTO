{
  "$schema": "https://opencode.ai/config.json",
  "provider": "minimax",
  "model": "MiniMax-M2.1",
  "agent": {
    "ideator": {
      "description": "Finds innovative project ideas from various sources",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/ideator.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true
      }
    },
    "planner": {
      "description": "Creates detailed implementation plans",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/planner.md}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true
      }
    },
    "developer": {
      "description": "Implements code based on plans",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/developer.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "glob": true
      }
    },
    "tester": {
      "description": "Tests and validates implementations",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/tester.md}",
      "tools": {
        "read": true,
        "bash": true,
        "grep": true,
        "glob": true
      }
    },
    "uploader": {
      "description": "Uploads projects to GitHub",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/uploader.md}",
      "tools": {
        "read": true,
        "write": true,
        "bash": true,
        "grep": true
      }
    },
    "evangelist": {
      "description": "Promotes projects on X/Twitter",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.1",
      "prompt": "{file:.opencode/agent/evangelist.md}",
      "tools": {
        "read": true,
        "bash": true
      }
    }
  },
  "mcpServers": {
    "search": {
      "command": "python",
      "args": ["-m", "mcp_servers.search_mcp"],
      "description": "Search arXiv, Reddit, Hacker News, Product Hunt"
    },
    "github": {
      "command": "python",
      "args": ["-m", "mcp_servers.github_mcp"],
      "description": "GitHub repository management"
    },
    "x_api": {
      "command": "python",
      "args": ["-m", "mcp_servers.x_mcp"],
      "description": "X/Twitter API for posting and searching"
    },
    "database": {
      "command": "python",
      "args": ["-m", "mcp_servers.database_mcp"],
      "description": "Local database for ideas and projects"
    }
  },
  "settings": {
    "temperature": 0.7,
    "maxTokens": 8192,
    "timeout": 300
  }
}
