# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=7000%AUTO
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OpenCode AI Settings (Required)
# -----------------------------------------------------------------------------
# Supports both Anthropic-compatible and OpenAI-compatible API providers!
#
# OPENCODE_PROVIDER determines which SDK to use:
#   - "anthropic" : For Anthropic-compatible APIs (Claude, MiniMax, etc.)
#   - "openai"    : For OpenAI-compatible APIs (OpenAI, Together, Groq, etc.)
#
# Examples:
#
#   MiniMax (Anthropic-compatible, default):
#       OPENCODE_PROVIDER=anthropic
#       OPENCODE_API_BASE=https://api.minimax.io/anthropic/v1
#       OPENCODE_MODEL=MiniMax-M2.1
#       OPENCODE_MAX_TOKENS=196608
#
#   Claude (Anthropic):
#       OPENCODE_PROVIDER=anthropic
#       OPENCODE_API_BASE=https://api.anthropic.com
#       OPENCODE_MODEL=claude-3-5-sonnet-20241022
#       OPENCODE_MAX_TOKENS=8192
#
#   OpenAI:
#       OPENCODE_PROVIDER=openai
#       OPENCODE_API_BASE=https://api.openai.com/v1
#       OPENCODE_MODEL=gpt-4o
#       OPENCODE_MAX_TOKENS=16384
#
#   Together (OpenAI-compatible):
#       OPENCODE_PROVIDER=openai
#       OPENCODE_API_BASE=https://api.together.xyz/v1
#       OPENCODE_MODEL=meta-llama/Llama-3-70b-chat-hf
#
#   Groq (OpenAI-compatible):
#       OPENCODE_PROVIDER=openai
#       OPENCODE_API_BASE=https://api.groq.com/openai/v1
#       OPENCODE_MODEL=llama-3.1-70b-versatile
#
#   Local Ollama (OpenAI-compatible):
#       OPENCODE_PROVIDER=openai
#       OPENCODE_API_BASE=http://localhost:11434/v1
#       OPENCODE_MODEL=llama3.1

# Your API key for the provider
OPENCODE_API_KEY=your_api_key_here

# API provider type: "anthropic" or "openai"
OPENCODE_PROVIDER=anthropic

# API base URL
OPENCODE_API_BASE=https://api.minimax.io/anthropic/v1

# Model name to use
OPENCODE_MODEL=MiniMax-M2.1

# Maximum output tokens for AI responses
# Adjust based on your model's capabilities (e.g., 8192 for Claude, 16384 for GPT-4, 196608 for MiniMax)
OPENCODE_MAX_TOKENS=196608

# OpenCode server URL (optional, auto-started if not set)
# OPENCODE_SERVER_URL=http://127.0.0.1:18080

# -----------------------------------------------------------------------------
# GitHub Integration (Required for Uploader agent)
# -----------------------------------------------------------------------------
# GitHub Personal Access Token with repo scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# GitHub username (optional, for repo creation)
# GITHUB_USERNAME=your_username

# -----------------------------------------------------------------------------
# X/Twitter Integration (Required for Evangelist agent)
# -----------------------------------------------------------------------------
# Get API keys at: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Bearer Token for API v2 (optional)
# X_BEARER_TOKEN=your_x_bearer_token_here

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# Database connection URL
# SQLite (default): sqlite+aiosqlite:///./data/7000auto.db
# PostgreSQL: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/7000auto.db

# Echo SQL queries (for debugging)
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080

# -----------------------------------------------------------------------------
# Orchestrator Settings
# -----------------------------------------------------------------------------
# Auto-start the orchestrator pipeline on application boot
AUTO_START=true

# Maximum number of concurrent projects
MAX_CONCURRENT_PROJECTS=1

# -----------------------------------------------------------------------------
# Workspace Settings
# -----------------------------------------------------------------------------
# Directory for project workspaces
WORKSPACE_DIR=./workspace
