# =============================================================================
# 7000%AUTO Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Application Settings
APP_NAME=7000%AUTO
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# MiniMax AI Configuration (REQUIRED)
# Get your API key from: https://platform.minimax.chat
# =============================================================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=minimax-m2.1
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MAX_TOKENS=4096
MINIMAX_TEMPERATURE=0.7

# =============================================================================
# OpenCode SDK Configuration
# =============================================================================
OPENCODE_BASE_URL=http://localhost:3000
OPENCODE_API_KEY=

# =============================================================================
# GitHub Configuration (REQUIRED for Uploader agent)
# Create a personal access token at: https://github.com/settings/tokens
# =============================================================================
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_DEFAULT_REPO=

# =============================================================================
# X/Twitter API Configuration (REQUIRED for Evangelist agent)
# Get your API keys from: https://developer.twitter.com/en/portal/dashboard
# =============================================================================
X_API_KEY=your_twitter_api_key
X_API_SECRET=your_twitter_api_secret
X_ACCESS_TOKEN=your_twitter_access_token
X_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
X_BEARER_TOKEN=your_twitter_bearer_token

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/7000auto.db
DATABASE_ECHO=false

# =============================================================================
# Directory Configuration
# =============================================================================
WORKSPACE_DIR=./workspace
DATA_DIR=./data
LOGS_DIR=./logs

# =============================================================================
# Agent Configuration
# =============================================================================
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT=300
ORCHESTRATOR_INTERVAL=60

# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_SEARCH_ENABLED=true
MCP_GITHUB_ENABLED=true
MCP_X_API_ENABLED=true
MCP_DATABASE_ENABLED=true
